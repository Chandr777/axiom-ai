{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/monitoring/run.js": {
      "maxDuration": 300
    },
    "api/monitoring/cron.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/monitoring/cron",
      "schedule": "0 4 * * 1"
    }
  ]
}
