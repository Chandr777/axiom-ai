{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/knowledge",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/knowledge/:path*",
      "destination": "/faq",
      "permanent": true
    }
  ]
}
