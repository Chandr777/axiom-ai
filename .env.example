# Add in Vercel Settings > Environment Variables. Never use VITE_ prefix for secrets.
MONITORING_ACCESS_KEY=generate-a-long-random-secret
# Only needed if a Vercel Cron schedule is explicitly enabled after budget approval.
CRON_SECRET=generate-another-long-random-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Add provider keys only after model IDs, pricing, and budget are reviewed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=pro-search
# Hard stop threshold for sequential runs; actual costs are saved per provider.
SOV_BUDGET_USD=5
# Enable Perplexity only after its response usage.cost_usd field is verified in Preview.
PERPLEXITY_COST_TRACKING_ENABLED=false
# Optional: monitoring execution tuning
SOV_CONCURRENCY=18
SOV_REQUEST_TIMEOUT_MS=45000
